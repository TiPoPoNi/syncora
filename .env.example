# ==============================================================================
# Project Resource Allocation & Scheduling System (PRS) - Environment Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target deployment.
# Never commit real credentials to version control.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prs_db
SPRING_DATASOURCE_USERNAME=prs_user
SPRING_DATASOURCE_PASSWORD=prs_password

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Intelligence Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

# Phase 10: Workflow Automation & Email Delivery Configuration
# Leave MAIL_HOST empty or MAIL_ENABLED=false for Mock Email Delivery mode (default for dev/demo)
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=no-reply@prs-system.local
MAIL_TLS=true

# Phase 10: Automated Deadline Reminder Scheduling
# Default runs every hour; can be set to cron expression or fixed delay
REMINDER_CRON=0 0 * * * *
REMINDER_ENABLED=true
REMINDER_UPCOMING_WINDOW_HOURS=24
REMINDER_ADVANCE_WINDOW_DAYS=3

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8080/api

# Phase 15: External Integrations & Interoperability
# Google Calendar Integration (Optional OAuth2 client credentials)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/integrations/calendars/GOOGLE_CALENDAR/callback

# Microsoft Outlook Integration (Optional OAuth2 client credentials)
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:8080/api/integrations/calendars/OUTLOOK_CALENDAR/callback

# Webhook Outbox Delivery Configuration
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_ALLOW_PRIVATE_NETWORK=false
